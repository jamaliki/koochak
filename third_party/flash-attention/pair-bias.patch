+inline at::cuda::CUDAGuard make_cuda_guard_from_tensor_pb(const at::Tensor& t) {
+    return at::cuda::CUDAGuard(static_cast<c10::DeviceIndex>(t.get_device()));
+}
+
+inline int round_multiple_pb(int x, int m) {
+    return (x + m - 1) / m * m;
+}
+
+inline int round_up_headdim_pb(int head_size) {
+    if (head_size <= 64) { return 64; }
+    if (head_size <= 96) { return 96; }
+    if (head_size <= 128) { return 128; }
+    if (head_size <= 192) { return 192; }
+    return 256;
+}
+
+constexpr int kPrepareVarlenMaxBatches1CtaPb = 992;
+
+inline void validate_lengths_pb(
+    const std::optional<at::Tensor>& seqused,
+    int64_t batch,
+    const char* name
+) {
+    if (!seqused.has_value()) { return; }
+    PB_CHECK_DEVICE(seqused.value());
+    TORCH_CHECK(seqused.value().is_contiguous(), name, " must be contiguous");
+    TORCH_CHECK(seqused.value().dtype() == torch::kInt32, name, " must have dtype int32");
+    PB_CHECK_SHAPE(seqused.value(), batch);
+}
+
+inline void set_bias_params_pb(Flash_fwd_params &params, const at::Tensor& bias) {
+    params.bias_ptr = bias.data_ptr();
+    params.bias_batch_stride = bias.stride(0);
+    params.bias_head_stride = bias.stride(1);
+    params.bias_row_stride = bias.stride(2);
+    params.bias_col_stride = bias.stride(3);
+}
+
+inline void set_dbias_params_pb(Flash_bwd_params &params, const at::Tensor& dbias) {
+    params.dbias_ptr = dbias.data_ptr();
+    params.dbias_batch_stride = dbias.stride(0);
+    params.dbias_head_stride = dbias.stride(1);
+    params.dbias_row_stride = dbias.stride(2);
+    params.dbias_col_stride = dbias.stride(3);
+}
+
+at::Tensor setup_fwd_varlen_scheduler_pb(
+    Flash_fwd_params& params,
+    const c10::TensorOptions& opts,
+    bool is_varlen
+) {
+    params.prepare_varlen_pdl = is_varlen && params.b <= kPrepareVarlenMaxBatches1CtaPb;
+    params.varlen_sort_batches = !params.is_local;
+    params.head_swizzle = params.is_causal || params.is_local;
+
+    bool const scheduler_needs_semaphore = params.arch >= 90
+        ? (((params.is_causal || params.is_local) && (params.num_splits == 1)) || is_varlen)
+        : ((params.is_causal && !is_varlen) || (is_varlen && params.num_splits > 1));
+    if (!scheduler_needs_semaphore && !is_varlen) {
+        return at::Tensor{};
+    }
+
+    int const b_rounded = round_multiple_pb(params.b, 4);
+    int num_prepare_batch_vectors = is_varlen ? 2 : 0;
+    if (params.varlen_sort_batches) { num_prepare_batch_vectors += 1; }
+    if (params.head_swizzle) { num_prepare_batch_vectors += 1; }
+    int const head_swizzle_offset = b_rounded * (params.varlen_sort_batches ? 3 : 2);
+    int const tile_count_semaphore_offset = b_rounded * num_prepare_batch_vectors;
+    int const metadata_size = int(scheduler_needs_semaphore) + tile_count_semaphore_offset;
+
+    at::Tensor metadata = torch::empty({metadata_size}, opts.dtype(torch::kInt32));
+    if (scheduler_needs_semaphore && !is_varlen) {
+        metadata.zero_();
+    }
+    params.skip_scheduler_metadata_computation = false;
+    params.num_splits_dynamic_ptr = is_varlen ? metadata.data_ptr<int>() : nullptr;
+    params.num_m_blocks_ptr = is_varlen ? metadata.data_ptr<int>() + b_rounded : nullptr;
+    params.varlen_batch_idx_ptr = is_varlen && params.varlen_sort_batches
+        ? metadata.data_ptr<int>() + b_rounded * 2
+        : nullptr;
+    params.num_nheads_in_l2_ptr = is_varlen && params.head_swizzle
+        ? metadata.data_ptr<int>() + head_swizzle_offset
+        : nullptr;
+    params.tile_count_semaphore = scheduler_needs_semaphore
+        ? metadata.data_ptr<int>() + tile_count_semaphore_offset
+        : nullptr;
+    params.tile_count_semaphore_offset = tile_count_semaphore_offset;
+    return metadata;
+}
+
+struct PairBiasShape {
+    int batch;
+    int seqlen_q;
+    int seqlen_k;
+    int heads;
+    int heads_k;
+    int head_dim;
+    int head_dim_v;
+};
+
+PairBiasShape validate_pair_bias_inputs(
+    const at::Tensor& q,
+    const at::Tensor& k,
+    const at::Tensor& v,
+    const at::Tensor& bias
+) {
+    auto dprops = at::cuda::getCurrentDeviceProperties();
+    TORCH_CHECK(dprops->major >= 9, "FA3 dense pair-bias attention requires Hopper (SM90+) GPUs");
+    PB_CHECK_DEVICE(q);
+    PB_CHECK_DEVICE(k);
+    PB_CHECK_DEVICE(v);
+    PB_CHECK_DEVICE(bias);
+    TORCH_CHECK(q.dtype() == torch::kFloat16 || q.dtype() == torch::kBFloat16,
+                "FA3 pair-bias attention supports fp16/bf16 q/k/v");
+    TORCH_CHECK(k.dtype() == q.dtype() && v.dtype() == q.dtype() && bias.dtype() == q.dtype(),
+                "q, k, v, and bias must have the same dtype in the first pair-bias FA3 path");
+    TORCH_CHECK(q.dim() == 4 && k.dim() == 4 && v.dim() == 4,
+                "q, k, v must have shape [B, S, H, D]");
+    TORCH_CHECK(bias.dim() == 4, "bias must have shape [B, H, S_q, S_k]");
+    TORCH_CHECK(q.stride(-1) == 1 && k.stride(-1) == 1 && v.stride(-1) == 1,
+                "q, k, and v must be contiguous in the head dimension");
+    TORCH_CHECK(bias.is_contiguous(), "bias must be contiguous [B, H, S_q, S_k]");
+    TORCH_CHECK(bias.numel() <= std::numeric_limits<int>::max(),
+                "pair_bias kernel currently requires bias.numel() <= INT_MAX for 32-bit score offsets");
+
+    PairBiasShape shape{
+        static_cast<int>(q.size(0)),
+        static_cast<int>(q.size(1)),
+        static_cast<int>(k.size(1)),
+        static_cast<int>(q.size(2)),
+        static_cast<int>(k.size(2)),
+        static_cast<int>(q.size(3)),
+        static_cast<int>(v.size(3)),
+    };
+    PB_CHECK_SHAPE(k, shape.batch, shape.seqlen_k, shape.heads_k, shape.head_dim);
+    PB_CHECK_SHAPE(v, shape.batch, shape.seqlen_k, shape.heads_k, shape.head_dim_v);
+    PB_CHECK_SHAPE(bias, shape.batch, shape.heads, shape.seqlen_q, shape.seqlen_k);
+    TORCH_CHECK(shape.heads == shape.heads_k,
+                "first FA3 pair-bias path supports equal Q/K/V head counts only");
+    TORCH_CHECK(shape.head_dim == shape.head_dim_v,
+                "first FA3 pair-bias path supports equal Q/K and V head dimensions only");
+    TORCH_CHECK(shape.head_dim % 8 == 0, "head_dim must be a multiple of 8");
+    TORCH_CHECK(shape.head_dim <= 256, "head_dim must be <= 256");
+    return shape;
+}
+
+PairBiasShape validate_pair_bias_qkv_inputs(
+    const at::Tensor& q,
+    const at::Tensor& k,
+    const at::Tensor& v
+) {
+    auto dprops = at::cuda::getCurrentDeviceProperties();
+    TORCH_CHECK(dprops->major >= 9, "FA3 compact pair-bias attention requires Hopper (SM90+) GPUs");
+    PB_CHECK_DEVICE(q);
+    PB_CHECK_DEVICE(k);
+    PB_CHECK_DEVICE(v);
+    TORCH_CHECK(q.dtype() == torch::kFloat16 || q.dtype() == torch::kBFloat16,
+                "FA3 compact pair-bias attention supports fp16/bf16 q/k/v");
+    TORCH_CHECK(k.dtype() == q.dtype() && v.dtype() == q.dtype(),
+                "q, k, and v must have the same dtype in the compact pair-bias FA3 path");
+    TORCH_CHECK(q.dim() == 4 && k.dim() == 4 && v.dim() == 4,
+                "q, k, v must have shape [B, S, H, D]");
+    TORCH_CHECK(q.stride(-1) == 1 && k.stride(-1) == 1 && v.stride(-1) == 1,
+                "q, k, and v must be contiguous in the head dimension");
+
+    PairBiasShape shape{
+        static_cast<int>(q.size(0)),
+        static_cast<int>(q.size(1)),
+        static_cast<int>(k.size(1)),
+        static_cast<int>(q.size(2)),
+        static_cast<int>(k.size(2)),
+        static_cast<int>(q.size(3)),
+        static_cast<int>(v.size(3)),
+    };
+    PB_CHECK_SHAPE(k, shape.batch, shape.seqlen_k, shape.heads_k, shape.head_dim);
+    PB_CHECK_SHAPE(v, shape.batch, shape.seqlen_k, shape.heads_k, shape.head_dim_v);
+    TORCH_CHECK(shape.heads == shape.heads_k,
+                "compact FA3 pair-bias path supports equal Q/K/V head counts only");
+    TORCH_CHECK(shape.head_dim == shape.head_dim_v,
+                "compact FA3 pair-bias path supports equal Q/K and V head dimensions only");
+    TORCH_CHECK(shape.head_dim % 8 == 0, "head_dim must be a multiple of 8");
+    TORCH_CHECK(shape.head_dim <= 256, "head_dim must be <= 256");
+    return shape;
+}
+
+void validate_compact_bias_pb(
+    const at::Tensor& bias_storage,
+    const at::Tensor& bias_batch_offsets,
+    const at::Tensor& bias_seq_lens,
+    int64_t batch,
+    c10::ScalarType dtype
+) {
+    PB_CHECK_DEVICE(bias_storage);
+    PB_CHECK_DEVICE(bias_batch_offsets);
+    PB_CHECK_DEVICE(bias_seq_lens);
+    TORCH_CHECK(bias_storage.dim() == 1 && bias_storage.is_contiguous(),
+                "compact bias_storage must be a contiguous 1D tensor");
+    TORCH_CHECK(bias_storage.dtype() == dtype, "compact bias_storage must match q dtype");
+    TORCH_CHECK(bias_batch_offsets.is_contiguous() && bias_batch_offsets.dtype() == torch::kInt64,
+                "bias_batch_offsets must be contiguous int64");
+    TORCH_CHECK(bias_seq_lens.is_contiguous() && bias_seq_lens.dtype() == torch::kInt32,
+                "bias_seq_lens must be contiguous int32");
+    PB_CHECK_SHAPE(bias_batch_offsets, batch);
+    PB_CHECK_SHAPE(bias_seq_lens, batch);
+    TORCH_CHECK(bias_storage.numel() <= std::numeric_limits<int>::max(),
+                "compact pair_bias kernel currently requires bias_storage.numel() <= INT_MAX");
+}
+
+}  // namespace
+
+std::tuple<at::Tensor, at::Tensor> mha_pair_bias_fwd(
+    at::Tensor q,
+    at::Tensor k,
+    at::Tensor v,
+    at::Tensor bias,
+    std::optional<at::Tensor> seqused_q_,
+    std::optional<at::Tensor> seqused_k_,
+    std::optional<double> softmax_scale_,
+    int64_t sm_margin
+) {
+    auto shape = validate_pair_bias_inputs(q, k, v, bias);
+    validate_lengths_pb(seqused_q_, shape.batch, "seqused_q");
+    validate_lengths_pb(seqused_k_, shape.batch, "seqused_k");
+    auto device_guard = make_cuda_guard_from_tensor_pb(q);
+
+    double softmax_scale = softmax_scale_.has_value()
+        ? softmax_scale_.value()
+        : 1.0 / std::sqrt(double(shape.head_dim));
+    auto opts = q.options();
+    // With used-lengths, FA3 does not write padded query rows.  Zero only in
+    // that varlen case so dense/no-padding launches keep the cheaper empty
+    // allocation.
+    auto out = seqused_q_.has_value()
+        ? torch::zeros({shape.batch, shape.seqlen_q, shape.heads, shape.head_dim_v}, opts)
+        : torch::empty({shape.batch, shape.seqlen_q, shape.heads, shape.head_dim_v}, opts);
+    auto softmax_lse = torch::empty({shape.batch, shape.heads, shape.seqlen_q}, opts.dtype(at::kFloat));
+
+    int const head_dim_rounded = round_up_headdim_pb(shape.head_dim);
+    int const seqlen_q_rounded = round_multiple_pb(shape.seqlen_q, 128);
+    int const seqlen_k_rounded = round_multiple_pb(shape.seqlen_k, 128);
+
+    Flash_fwd_params params {};
+    set_params_fprop(
+        params,
+        shape.batch,
+        shape.seqlen_q,
+        shape.seqlen_k,
+        seqlen_q_rounded,
+        seqlen_k_rounded,
+        shape.heads,
+        shape.heads_k,
+        shape.head_dim,
+        head_dim_rounded,
+        q,
+        k,
+        v,
+        out,
+        nullptr,
+        nullptr,
+        seqused_q_.has_value() ? seqused_q_.value().data_ptr() : nullptr,
+        seqused_k_.has_value() ? seqused_k_.value().data_ptr() : nullptr,
+        softmax_lse.data_ptr(),
+        0.0f,
+        static_cast<float>(softmax_scale),
+        -1,
+        -1,
+        0,
+        0.0f,
+        static_cast<int>(sm_margin));
+    params.total_q = shape.batch * shape.seqlen_q;
+    params.total_k = shape.batch * shape.seqlen_k;
+    params.dv = shape.head_dim_v;
+    params.dv_rounded = head_dim_rounded;
+    params.num_splits = 1;
+    params.pack_gqa = false;
+    set_bias_params_pb(params, bias);
+    at::Tensor scheduler_metadata = setup_fwd_varlen_scheduler_pb(
+        params,
+        opts,
+        seqused_q_.has_value() || seqused_k_.has_value());
+
+    if (params.total_q > 0 && params.total_k > 0 && shape.heads > 0) {
+        auto stream = at::cuda::getCurrentCUDAStream().stream();
+        run_mha_fwd(params, stream);
+    } else {
+        out.zero_();
+        softmax_lse.fill_(std::numeric_limits<float>::infinity());
+    }
+    return {out, softmax_lse};
+}
+
+std::tuple<at::Tensor, at::Tensor> mha_pair_bias_compact_fwd(
+    at::Tensor q,
+    at::Tensor k,
+    at::Tensor v,
+    at::Tensor bias_storage,
+    at::Tensor bias_batch_offsets,
+    at::Tensor bias_seq_lens,
+    std::optional<at::Tensor> seqused_q_,
+    std::optional<at::Tensor> seqused_k_,
+    std::optional<double> softmax_scale_,
+    int64_t sm_margin
+) {
+    auto shape = validate_pair_bias_qkv_inputs(q, k, v);
+    validate_compact_bias_pb(bias_storage, bias_batch_offsets, bias_seq_lens, shape.batch, q.scalar_type());
+    validate_lengths_pb(seqused_q_, shape.batch, "seqused_q");
+    validate_lengths_pb(seqused_k_, shape.batch, "seqused_k");
+    TORCH_CHECK(seqused_q_.has_value() && seqused_k_.has_value(),
+                "compact pair-bias FA3 requires used lengths for q and k");
+    auto device_guard = make_cuda_guard_from_tensor_pb(q);
+
+    double softmax_scale = softmax_scale_.has_value()
+        ? softmax_scale_.value()
+        : 1.0 / std::sqrt(double(shape.head_dim));
+    auto opts = q.options();
+    auto out = torch::zeros({shape.batch, shape.seqlen_q, shape.heads, shape.head_dim_v}, opts);
+    auto softmax_lse = torch::empty({shape.batch, shape.heads, shape.seqlen_q}, opts.dtype(at::kFloat));
+
+    int const head_dim_rounded = round_up_headdim_pb(shape.head_dim);
+    int const seqlen_q_rounded = round_multiple_pb(shape.seqlen_q, 128);
+    int const seqlen_k_rounded = round_multiple_pb(shape.seqlen_k, 128);
+
+    Flash_fwd_params params {};
+    set_params_fprop(
+        params,
+        shape.batch,
+        shape.seqlen_q,
+        shape.seqlen_k,
+        seqlen_q_rounded,
+        seqlen_k_rounded,
+        shape.heads,
+        shape.heads_k,
+        shape.head_dim,
+        head_dim_rounded,
+        q,
+        k,
+        v,
+        out,
+        nullptr,
+        nullptr,
+        seqused_q_.value().data_ptr(),
+        seqused_k_.value().data_ptr(),
+        softmax_lse.data_ptr(),
+        0.0f,
+        static_cast<float>(softmax_scale),
+        -1,
+        -1,
+        0,
+        0.0f,
+        static_cast<int>(sm_margin));
+    params.total_q = shape.batch * shape.seqlen_q;
+    params.total_k = shape.batch * shape.seqlen_k;
+    params.dv = shape.head_dim_v;
+    params.dv_rounded = head_dim_rounded;
+    params.num_splits = 1;
+    params.pack_gqa = false;
+    params.bias_ptr = bias_storage.data_ptr();
+    params.bias_batch_stride = 0;
+    params.bias_head_stride = 0;
+    params.bias_row_stride = 0;
+    params.bias_col_stride = 1;
+    params.bias_batch_offsets = bias_batch_offsets.data_ptr<int64_t>();
+    params.bias_seq_lens = bias_seq_lens.data_ptr<int>();
+    at::Tensor scheduler_metadata = setup_fwd_varlen_scheduler_pb(params, opts, true);
+
+    if (params.total_q > 0 && params.total_k > 0 && shape.heads > 0) {
+        auto stream = at::cuda::getCurrentCUDAStream().stream();
+        run_mha_fwd(params, stream);
+    } else {
+        out.zero_();
+        softmax_lse.fill_(std::numeric_limits<float>::infinity());
+    }
+    return {out, softmax_lse};
+}
+
+std::tuple<at::Tensor, at::Tensor, at::Tensor, at::Tensor> mha_pair_bias_bwd(
+    at::Tensor dout,
+    at::Tensor q,
+    at::Tensor k,
+    at::Tensor v,
+    at::Tensor bias,
+    at::Tensor out,
+    at::Tensor softmax_lse,
+    std::optional<at::Tensor> seqused_q_,
+    std::optional<at::Tensor> seqused_k_,
+    std::optional<double> softmax_scale_,
+    bool deterministic,
+    int64_t sm_margin,
+    bool zero_padded_dbias
+) {
+    auto shape = validate_pair_bias_inputs(q, k, v, bias);
+    validate_lengths_pb(seqused_q_, shape.batch, "seqused_q");
+    validate_lengths_pb(seqused_k_, shape.batch, "seqused_k");
+    PB_CHECK_DEVICE(dout);
+    PB_CHECK_DEVICE(out);
+    PB_CHECK_DEVICE(softmax_lse);
+    PB_CHECK_SHAPE(dout, shape.batch, shape.seqlen_q, shape.heads, shape.head_dim_v);
+    PB_CHECK_SHAPE(out, shape.batch, shape.seqlen_q, shape.heads, shape.head_dim_v);
+    PB_CHECK_SHAPE(softmax_lse, shape.batch, shape.heads, shape.seqlen_q);
+    TORCH_CHECK(dout.dtype() == q.dtype() && out.dtype() == q.dtype(),
+                "dout and out must have q dtype");
+    TORCH_CHECK(dout.stride(-1) == 1 && out.stride(-1) == 1,
+                "dout and out must be contiguous in the head dimension");
+
+    auto device_guard = make_cuda_guard_from_tensor_pb(q);
+    double softmax_scale = softmax_scale_.has_value()
+        ? softmax_scale_.value()
+        : 1.0 / std::sqrt(double(shape.head_dim));
+    auto opts = q.options();
+
+    auto dq = torch::empty_like(q);
+    auto dk = torch::empty_like(k);
+    auto dv = torch::empty_like(v);
+    // Backward writes dBias only for active score tiles when used-lengths are
+    // present.  The safe default zero-fills padding to preserve dense autograd
+    // semantics.  Kaveh's padding-aware projection backward opts out after it
+    // has active residue lengths, saving a full [B,H,N,N] memset per layer.
+    at::Tensor dbias = ((seqused_q_.has_value() || seqused_k_.has_value()) && zero_padded_dbias)
+        ? torch::zeros_like(bias)
+        : torch::empty_like(bias);
+
+    int const arch = at::cuda::getCurrentDeviceProperties()->major * 10
+                   + at::cuda::getCurrentDeviceProperties()->minor;
+    int const head_dim_rounded = round_up_headdim_pb(std::max(shape.head_dim, shape.head_dim_v));
+    int const head_dim_v_rounded = head_dim_rounded;
+    TORCH_CHECK(!deterministic || head_dim_rounded < 256,
+                "deterministic backward is not supported for hdim 256");
+
+    int const kBlockM_sm90 = head_dim_rounded <= 64 ? 64
+        : (head_dim_rounded <= 96 ? 64
+           : (head_dim_rounded <= 128 ? 80 : 64));
+    int const kBlockM_sm80 = head_dim_rounded <= 64 ? 128 : 64;
+    int const kBlockM_sm86 = head_dim_rounded <= 192 ? 64 : 32;
+    int const kBlockM = arch >= 90 ? kBlockM_sm90 : (arch == 86 || arch == 89 ? kBlockM_sm86 : kBlockM_sm80);
+    int const kBlockN_sm90 = head_dim_rounded <= 128 ? 128 : (head_dim_rounded <= 192 ? 96 : 80);
+    int const kBlockN_sm80 = head_dim_rounded <= 128 ? 128 : (head_dim_rounded <= 192 ? 80 : 64);
+    int const kBlockN_sm86 = head_dim_rounded <= 64 ? 128
+        : (head_dim_rounded <= 96 ? 128
+           : (head_dim_rounded <= 128 ? 96 : 64));
+    int const kBlockN = arch >= 90 ? kBlockN_sm90 : (arch == 86 || arch == 89 ? kBlockN_sm86 : kBlockN_sm80);
+    int const seqlen_q_rounded = round_multiple_pb(shape.seqlen_q, kBlockM);
+    int const seqlen_k_rounded = round_multiple_pb(shape.seqlen_k, kBlockN);
+
+    auto softmax_d = torch::empty({shape.batch, shape.heads, seqlen_q_rounded}, opts.dtype(at::kFloat));
+    auto softmax_lse_log2 = torch::empty({shape.batch, shape.heads, seqlen_q_rounded}, opts.dtype(at::kFloat));
+    auto dq_accum = torch::empty(
+        {shape.batch, shape.heads, seqlen_q_rounded * head_dim_rounded},
+        opts.dtype(at::kFloat));
+    auto dq_semaphore = torch::empty(
+        {(shape.seqlen_q + kBlockM - 1) / kBlockM, shape.batch, shape.heads},
+        opts.dtype(torch::kInt32));
+
+    Flash_bwd_params params {};
+    set_params_dgrad(
+        params,
+        shape.batch,
+        shape.seqlen_q,
+        shape.seqlen_k,
+        seqlen_q_rounded,
+        seqlen_k_rounded,
+        shape.heads,
+        shape.heads_k,
+        shape.head_dim,
+        head_dim_rounded,
+        q,
+        k,
+        v,
+        out,
+        dout,
+        dq,
+        dk,
+        dv,
+        nullptr,
+        nullptr,
+        seqused_q_.has_value() ? seqused_q_.value().data_ptr() : nullptr,
+        seqused_k_.has_value() ? seqused_k_.value().data_ptr() : nullptr,
+        dq_accum.data_ptr(),
+        nullptr,
+        nullptr,
+        softmax_lse.data_ptr(),
+        softmax_d.data_ptr(),
+        0.0f,
+        static_cast<float>(softmax_scale),
+        -1,
+        -1,
+        0,
+        0.0f,
+        deterministic,
+        static_cast<int>(sm_margin));
+    params.total_q = shape.batch * shape.seqlen_q;
+    params.total_k = shape.batch * shape.seqlen_k;
+    params.softmax_lse_log2_ptr = softmax_lse_log2.data_ptr();
+    params.dv = shape.head_dim_v;
+    params.dv_rounded = head_dim_v_rounded;
+    params.dq_semaphore = dq_semaphore.data_ptr<int>();
+    set_bias_params_pb(params, bias);
+    set_dbias_params_pb(params, dbias);
+
+    if (params.total_q > 0 && params.total_k > 0 && shape.heads > 0) {
+        auto stream = at::cuda::getCurrentCUDAStream().stream();
+        run_mha_bwd(params, stream);
+        zero_pair_bias_bwd_padding(dq, dk, dv, seqused_q_, seqused_k_, stream);
+    } else {
+        dq.zero_();
+        dk.zero_();
+        dv.zero_();
+        dbias.zero_();
+    }
+    return {dq, dk, dv, dbias};
+}
+
+std::tuple<at::Tensor, at::Tensor, at::Tensor, at::Tensor> mha_pair_bias_compact_bwd(
+    at::Tensor dout,
+    at::Tensor q,
+    at::Tensor k,
+    at::Tensor v,
+    at::Tensor bias_storage,
+    at::Tensor bias_batch_offsets,
+    at::Tensor bias_seq_lens,
+    at::Tensor out,
+    at::Tensor softmax_lse,
+    std::optional<at::Tensor> seqused_q_,
+    std::optional<at::Tensor> seqused_k_,
+    std::optional<double> softmax_scale_,
+    bool deterministic,
+    int64_t sm_margin
+) {
+    auto shape = validate_pair_bias_qkv_inputs(q, k, v);
+    validate_compact_bias_pb(bias_storage, bias_batch_offsets, bias_seq_lens, shape.batch, q.scalar_type());
+    validate_lengths_pb(seqused_q_, shape.batch, "seqused_q");
+    validate_lengths_pb(seqused_k_, shape.batch, "seqused_k");
+    TORCH_CHECK(seqused_q_.has_value() && seqused_k_.has_value(),
+                "compact pair-bias FA3 backward requires used lengths for q and k");
+    PB_CHECK_DEVICE(dout);
+    PB_CHECK_DEVICE(out);
+    PB_CHECK_DEVICE(softmax_lse);
+    PB_CHECK_SHAPE(dout, shape.batch, shape.seqlen_q, shape.heads, shape.head_dim_v);
+    PB_CHECK_SHAPE(out, shape.batch, shape.seqlen_q, shape.heads, shape.head_dim_v);
+    PB_CHECK_SHAPE(softmax_lse, shape.batch, shape.heads, shape.seqlen_q);
+    TORCH_CHECK(dout.dtype() == q.dtype() && out.dtype() == q.dtype(),
+                "dout and out must have q dtype");
+    TORCH_CHECK(dout.stride(-1) == 1 && out.stride(-1) == 1,
+                "dout and out must be contiguous in the head dimension");
+
+    auto device_guard = make_cuda_guard_from_tensor_pb(q);
+    double softmax_scale = softmax_scale_.has_value()
+        ? softmax_scale_.value()
+        : 1.0 / std::sqrt(double(shape.head_dim));
+    auto opts = q.options();
+
+    auto dq = torch::empty_like(q);
+    auto dk = torch::empty_like(k);
+    auto dv = torch::empty_like(v);
+    auto dbias_storage = torch::empty_like(bias_storage);
+
+    int const arch = at::cuda::getCurrentDeviceProperties()->major * 10
+                   + at::cuda::getCurrentDeviceProperties()->minor;
+    int const head_dim_rounded = round_up_headdim_pb(std::max(shape.head_dim, shape.head_dim_v));
+    int const head_dim_v_rounded = head_dim_rounded;
+    TORCH_CHECK(!deterministic || head_dim_rounded < 256,
+                "deterministic backward is not supported for hdim 256");
+
+    int const kBlockM_sm90 = head_dim_rounded <= 64 ? 64
+        : (head_dim_rounded <= 96 ? 64
+           : (head_dim_rounded <= 128 ? 80 : 64));
+    int const kBlockM_sm80 = head_dim_rounded <= 64 ? 128 : 64;
+    int const kBlockM_sm86 = head_dim_rounded <= 192 ? 64 : 32;
+    int const kBlockM = arch >= 90 ? kBlockM_sm90 : (arch == 86 || arch == 89 ? kBlockM_sm86 : kBlockM_sm80);
+    int const kBlockN_sm90 = head_dim_rounded <= 128 ? 128 : (head_dim_rounded <= 192 ? 96 : 80);
+    int const kBlockN_sm80 = head_dim_rounded <= 128 ? 128 : (head_dim_rounded <= 192 ? 80 : 64);
+    int const kBlockN_sm86 = head_dim_rounded <= 64 ? 128
+        : (head_dim_rounded <= 96 ? 128
+           : (head_dim_rounded <= 128 ? 96 : 64));
+    int const kBlockN = arch >= 90 ? kBlockN_sm90 : (arch == 86 || arch == 89 ? kBlockN_sm86 : kBlockN_sm80);
+    int const seqlen_q_rounded = round_multiple_pb(shape.seqlen_q, kBlockM);
+    int const seqlen_k_rounded = round_multiple_pb(shape.seqlen_k, kBlockN);
+
+    auto softmax_d = torch::empty({shape.batch, shape.heads, seqlen_q_rounded}, opts.dtype(at::kFloat));
+    auto softmax_lse_log2 = torch::empty({shape.batch, shape.heads, seqlen_q_rounded}, opts.dtype(at::kFloat));
+    auto dq_accum = torch::empty(
+        {shape.batch, shape.heads, seqlen_q_rounded * head_dim_rounded},
+        opts.dtype(at::kFloat));
+    auto dq_semaphore = torch::empty(
+        {(shape.seqlen_q + kBlockM - 1) / kBlockM, shape.batch, shape.heads},
+        opts.dtype(torch::kInt32));
+
+    Flash_bwd_params params {};
+    set_params_dgrad(
+        params,
+        shape.batch,
+        shape.seqlen_q,
+        shape.seqlen_k,
+        seqlen_q_rounded,
+        seqlen_k_rounded,
+        shape.heads,
+        shape.heads_k,
+        shape.head_dim,
+        head_dim_rounded,
+        q,
+        k,
+        v,
+        out,
+        dout,
+        dq,
+        dk,
+        dv,
+        nullptr,
+        nullptr,
+        seqused_q_.value().data_ptr(),
+        seqused_k_.value().data_ptr(),
+        dq_accum.data_ptr(),
+        nullptr,
+        nullptr,
+        softmax_lse.data_ptr(),
+        softmax_d.data_ptr(),
+        0.0f,
+        static_cast<float>(softmax_scale),
+        -1,
+        -1,
+        0,
+        0.0f,
+        deterministic,
+        static_cast<int>(sm_margin));
+    params.total_q = shape.batch * shape.seqlen_q;
+    params.total_k = shape.batch * shape.seqlen_k;
+    params.softmax_lse_log2_ptr = softmax_lse_log2.data_ptr();
+    params.dv = shape.head_dim_v;
+    params.dv_rounded = head_dim_v_rounded;
+    params.dq_semaphore = dq_semaphore.data_ptr<int>();
+    params.bias_ptr = bias_storage.data_ptr();
+    params.dbias_ptr = dbias_storage.data_ptr();
+    params.bias_batch_stride = 0;
+    params.bias_head_stride = 0;
+    params.bias_row_stride = 0;
+    params.bias_col_stride = 1;
+    params.dbias_batch_stride = 0;
+    params.dbias_head_stride = 0;
+    params.dbias_row_stride = 0;
+    params.dbias_col_stride = 1;
+    params.bias_batch_offsets = bias_batch_offsets.data_ptr<int64_t>();
+    params.bias_seq_lens = bias_seq_lens.data_ptr<int>();
+
+    if (params.total_q > 0 && params.total_k > 0 && shape.heads > 0) {
+        auto stream = at::cuda::getCurrentCUDAStream().stream();
+        run_mha_bwd(params, stream);
+        zero_pair_bias_bwd_padding(dq, dk, dv, seqused_q_, seqused_k_, stream);
+    } else {
+        dq.zero_();
+        dk.zero_();
+        dv.zero_();
+        dbias_storage.zero_();
+    }
+    return {dq, dk, dv, dbias_storage};
+}
+
+TORCH_LIBRARY_FRAGMENT(flash_attn_3, m) {
+    m.def("pair_bias_fwd("
+          "Tensor q,"
+          "Tensor k,"
+          "Tensor v,"
+          "Tensor bias,"
+          "Tensor? seqused_q = None,"
+          "Tensor? seqused_k = None,"
+          "float? softmax_scale = None,"
+          "int sm_margin = 0) -> (Tensor, Tensor)");
+    m.def("pair_bias_bwd("
+          "Tensor dout,"
+          "Tensor q,"
+          "Tensor k,"
+          "Tensor v,"
+          "Tensor bias,"
+          "Tensor out,"
+          "Tensor softmax_lse,"
+          "Tensor? seqused_q = None,"
+          "Tensor? seqused_k = None,"
+          "float? softmax_scale = None,"
+          "bool deterministic = False,"
+          "int sm_margin = 0,"
+          "bool zero_padded_dbias = True) -> (Tensor, Tensor, Tensor, Tensor)");
+    m.def("pair_bias_compact_fwd("
+          "Tensor q,"
+          "Tensor k,"
+          "Tensor v,"
+          "Tensor bias_storage,"
+          "Tensor bias_batch_offsets,"
+          "Tensor bias_seq_lens,"
+          "Tensor? seqused_q = None,"
+          "Tensor? seqused_k = None,"
+          "float? softmax_scale = None,"
+          "int sm_margin = 0) -> (Tensor, Tensor)");
+    m.def("pair_bias_compact_bwd("
+          "Tensor dout,"
+          "Tensor q,"
+          "Tensor k,"
+          "Tensor v,"
+          "Tensor bias_storage,"
+          "Tensor bias_batch_offsets,"
+          "Tensor bias_seq_lens,"
+          "Tensor out,"
+          "Tensor softmax_lse,"
+          "Tensor? seqused_q = None,"
+          "Tensor? seqused_k = None,"
+          "float? softmax_scale = None,"
+          "bool deterministic = False,"
+          "int sm_margin = 0) -> (Tensor, Tensor, Tensor, Tensor)");
+}
+
+TORCH_LIBRARY_IMPL(flash_attn_3, CUDA, m) {
+    m.impl("pair_bias_fwd", &mha_pair_bias_fwd);
+    m.impl("pair_bias_bwd", &mha_pair_bias_bwd);
+    m.impl("pair_bias_compact_fwd", &mha_pair_bias_compact_fwd);
+    m.impl("pair_bias_compact_bwd", &mha_pair_bias_compact_bwd);
+}
diff --git a/hopper/flash_pair_bias_padding.cu b/hopper/flash_pair_bias_padding.cu
new file mode 100644
index 0000000..cc58e85
--- /dev/null
+++ b/hopper/flash_pair_bias_padding.cu
@@ -0,0 +1,145 @@
+#include "flash_pair_bias_padding.h"
+
+#include <algorithm>
+#include <cstdint>
+
+#include <c10/cuda/CUDAException.h>
+
+namespace {
+
+constexpr int kThreads = 256;
+constexpr int kMaxBlocksX = 64;
+constexpr int kVecElems = 8;
+
+__device__ __forceinline__ int clamp_length(int length, int max_length) {
+    return length < 0 ? 0 : (length > max_length ? max_length : length);
+}
+
+__device__ __forceinline__ void zero_u16_span(uint16_t* ptr, int64_t offset, int count) {
+    if (count == kVecElems && (offset & (kVecElems - 1)) == 0) {
+        *reinterpret_cast<uint4*>(ptr + offset) = uint4{0, 0, 0, 0};
+    } else {
+        #pragma unroll
+        for (int i = 0; i < kVecElems; ++i) {
+            if (i < count) { ptr[offset + i] = uint16_t{0}; }
+        }
+    }
+}
+
+int blocks_for(int64_t elems) {
+    int64_t blocks = (elems + kThreads - 1) / kThreads;
+    blocks = std::max<int64_t>(1, std::min<int64_t>(blocks, kMaxBlocksX));
+    return static_cast<int>(blocks);
+}
+
+__global__ void zero_pair_bias_padding_kernel(
+    uint16_t* dq,
+    uint16_t* dk,
+    uint16_t* dv,
+    int const* seqused_q,
+    int const* seqused_k,
+    int batch,
+    int seqlen_q,
+    int seqlen_k,
+    int heads,
+    int head_dim,
+    int64_t dq_batch_stride,
+    int64_t dq_row_stride,
+    int64_t dq_head_stride,
+    int64_t dk_batch_stride,
+    int64_t dk_row_stride,
+    int64_t dk_head_stride,
+    int64_t dv_batch_stride,
+    int64_t dv_row_stride,
+    int64_t dv_head_stride,
+    int64_t max_tail_vecs) {
+    int const bidhb = blockIdx.y;
+    if (bidhb >= batch * heads) { return; }
+    int const bidb = bidhb / heads;
+    int const bidh = bidhb - bidb * heads;
+
+    int const seqlen_q_used = seqused_q ? clamp_length(seqused_q[bidb], seqlen_q) : seqlen_q;
+    int const seqlen_k_used = seqused_k ? clamp_length(seqused_k[bidb], seqlen_k) : seqlen_k;
+    int64_t const q_tail_vecs = int64_t(seqlen_q - seqlen_q_used) * (head_dim / kVecElems);
+    int64_t const k_tail_vecs = int64_t(seqlen_k - seqlen_k_used) * (head_dim / kVecElems);
+
+    int64_t idx = int64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t const stride = int64_t(gridDim.x) * blockDim.x;
+    int const head_dim_vecs = head_dim / kVecElems;
+    for (; idx < max_tail_vecs; idx += stride) {
+        if (seqused_q && idx < q_tail_vecs) {
+            int64_t const row_tail = idx / head_dim_vecs;
+            int64_t const dim = (idx - row_tail * head_dim_vecs) * kVecElems;
+            int64_t const offset = int64_t(bidb) * dq_batch_stride
+                                 + int64_t(seqlen_q_used + row_tail) * dq_row_stride
+                                 + int64_t(bidh) * dq_head_stride
+                                 + dim;
+            zero_u16_span(dq, offset, kVecElems);
+        }
+        if (seqused_k && idx < k_tail_vecs) {
+            int64_t const row_tail = idx / head_dim_vecs;
+            int64_t const dim = (idx - row_tail * head_dim_vecs) * kVecElems;
+            int64_t const dk_offset = int64_t(bidb) * dk_batch_stride
+                                    + int64_t(seqlen_k_used + row_tail) * dk_row_stride
+                                    + int64_t(bidh) * dk_head_stride
+                                    + dim;
+            int64_t const dv_offset = int64_t(bidb) * dv_batch_stride
+                                    + int64_t(seqlen_k_used + row_tail) * dv_row_stride
+                                    + int64_t(bidh) * dv_head_stride
+                                    + dim;
+            zero_u16_span(dk, dk_offset, kVecElems);
+            zero_u16_span(dv, dv_offset, kVecElems);
+        }
+    }
+}
+
+}  // namespace
+
+void zero_pair_bias_bwd_padding(
+    const at::Tensor& dq,
+    const at::Tensor& dk,
+    const at::Tensor& dv,
+    const std::optional<at::Tensor>& seqused_q,
+    const std::optional<at::Tensor>& seqused_k,
+    cudaStream_t stream) {
+    bool const has_q_padding = seqused_q.has_value();
+    bool const has_k_padding = seqused_k.has_value();
+    if (!has_q_padding && !has_k_padding) { return; }
+
+    auto* dq_ptr = reinterpret_cast<uint16_t*>(dq.data_ptr());
+    auto* dk_ptr = reinterpret_cast<uint16_t*>(dk.data_ptr());
+    auto* dv_ptr = reinterpret_cast<uint16_t*>(dv.data_ptr());
+    int const* seqused_q_ptr = has_q_padding ? seqused_q.value().data_ptr<int>() : nullptr;
+    int const* seqused_k_ptr = has_k_padding ? seqused_k.value().data_ptr<int>() : nullptr;
+
+    int const batch = static_cast<int>(dq.size(0));
+    int const seqlen_q = static_cast<int>(dq.size(1));
+    int const seqlen_k = static_cast<int>(dk.size(1));
+    int const heads = static_cast<int>(dq.size(2));
+    int const head_dim = static_cast<int>(dq.size(3));
+
+    int64_t const max_qkv_tail_vecs = int64_t(std::max(seqlen_q, seqlen_k)) * (head_dim / kVecElems);
+    dim3 const grid(blocks_for(max_qkv_tail_vecs), batch * heads);
+    zero_pair_bias_padding_kernel<<<grid, kThreads, 0, stream>>>(
+        dq_ptr,
+        dk_ptr,
+        dv_ptr,
+        seqused_q_ptr,
+        seqused_k_ptr,
+        batch,
+        seqlen_q,
+        seqlen_k,
+        heads,
+        head_dim,
+        dq.stride(0),
+        dq.stride(1),
+        dq.stride(2),
+        dk.stride(0),
+        dk.stride(1),
+        dk.stride(2),
+        dv.stride(0),
+        dv.stride(1),
+        dv.stride(2),
+        max_qkv_tail_vecs);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
