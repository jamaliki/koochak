+class FlashAttnPairBiasFunc(torch.autograd.Function):
+    """Dense additive pair-bias FA3 path.
+
+    Narrow contract for the Kaveh pair-bias kernel work:
+    q/k/v are [B, S, H, D], bias is [B, H, S_q, S_k], and optional
+    seqused_q/k are int32 [B] used lengths for padded variable-length batches.
+    ``zero_padded_dbias=False`` is valid only when the caller's bias-gradient
+    consumer ignores padded score rows/cols using the same used lengths.
+    """
+
+    @staticmethod
+    def forward(
+        ctx,
+        q,
+        k,
+        v,
+        bias,
+        seqused_q=None,
+        seqused_k=None,
+        softmax_scale=None,
+        deterministic=False,
+        sm_margin=0,
+        zero_padded_dbias=True,
+    ):
+        if softmax_scale is None:
+            softmax_scale = q.shape[-1] ** (-0.5)
+        q, k, v = [maybe_contiguous(x) for x in (q, k, v)]
+        bias = bias.contiguous()
+        seqused_q, seqused_k = [maybe_contiguous(x) for x in (seqused_q, seqused_k)]
+        out, softmax_lse = flash_attn_3_gpu.pair_bias_fwd(
+            q,
+            k,
+            v,
+            bias,
+            seqused_q,
+            seqused_k,
+            softmax_scale,
+            sm_margin,
+        )
+        ctx.save_for_backward(q, k, v, bias, out, softmax_lse)
+        ctx.seqused_q = seqused_q
+        ctx.seqused_k = seqused_k
+        ctx.softmax_scale = softmax_scale
+        ctx.deterministic = deterministic
+        ctx.sm_margin = sm_margin
+        ctx.zero_padded_dbias = bool(zero_padded_dbias)
+        return out
+
+    @staticmethod
+    def backward(ctx, dout):
+        q, k, v, bias, out, softmax_lse = ctx.saved_tensors
+        dout = maybe_contiguous(dout)
+        dq, dk, dv, dbias = flash_attn_3_gpu.pair_bias_bwd(
+            dout,
+            q,
+            k,
+            v,
+            bias,
+            out,
+            softmax_lse,
+            ctx.seqused_q,
+            ctx.seqused_k,
+            ctx.softmax_scale,
+            ctx.deterministic,
+            ctx.sm_margin,
+            ctx.zero_padded_dbias,
+        )
+        return dq, dk, dv, dbias, None, None, None, None, None, None
+
+
+def flash_attn_pair_bias_func(
+    q,
+    k,
+    v,
+    bias,
+    seqused_q=None,
+    seqused_k=None,
+    softmax_scale=None,
+    deterministic=False,
+    sm_margin=0,
+    zero_padded_dbias=True,
+):
+    return FlashAttnPairBiasFunc.apply(
+        q,
+        k,
+        v,
+        bias,
+        seqused_q,
+        seqused_k,
+        softmax_scale,
+        deterministic,
+        sm_margin,
+        zero_padded_dbias,
+    )
+
+
+class FlashAttnCompactPairBiasFunc(torch.autograd.Function):
+    """FA3 pair-bias path with compact per-batch bias storage.
+
+    ``bias_storage`` is a flat concatenation of per-example ``[H, L, L]`` bias
+    blocks. ``bias_batch_offsets[b]`` points to example ``b`` in elements, and
+    ``bias_seq_lens[b]`` gives that example's compact token length.  Q/K/V stay
+    in the ordinary padded batch layout so this remains one FA3 launch.
+    """
+
+    @staticmethod
+    def forward(
+        ctx,
+        q,
+        k,
+        v,
+        bias_storage,
+        bias_batch_offsets,
+        bias_seq_lens,
+        seqused_q,
+        seqused_k,
+        softmax_scale=None,
+        deterministic=False,
+        sm_margin=0,
+    ):
+        if softmax_scale is None:
+            softmax_scale = q.shape[-1] ** (-0.5)
+        q, k, v = [maybe_contiguous(x) for x in (q, k, v)]
+        bias_storage = bias_storage.contiguous()
+        bias_batch_offsets = maybe_contiguous(bias_batch_offsets)
+        bias_seq_lens = maybe_contiguous(bias_seq_lens)
+        seqused_q, seqused_k = [maybe_contiguous(x) for x in (seqused_q, seqused_k)]
+        out, softmax_lse = flash_attn_3_gpu.pair_bias_compact_fwd(
+            q,
+            k,
+            v,
+            bias_storage,
+            bias_batch_offsets,
+            bias_seq_lens,
+            seqused_q,
+            seqused_k,
+            softmax_scale,
+            sm_margin,
+        )
+        ctx.save_for_backward(q, k, v, bias_storage, bias_batch_offsets, bias_seq_lens, out, softmax_lse)
+        ctx.seqused_q = seqused_q
+        ctx.seqused_k = seqused_k
+        ctx.softmax_scale = softmax_scale
+        ctx.deterministic = deterministic
+        ctx.sm_margin = sm_margin
+        return out
+
+    @staticmethod
+    def backward(ctx, dout):
+        q, k, v, bias_storage, bias_batch_offsets, bias_seq_lens, out, softmax_lse = ctx.saved_tensors
+        dout = maybe_contiguous(dout)
+        dq, dk, dv, dbias_storage = flash_attn_3_gpu.pair_bias_compact_bwd(
+            dout,
+            q,
+            k,
+            v,
+            bias_storage,
+            bias_batch_offsets,
+            bias_seq_lens,
+            out,
+            softmax_lse,
+            ctx.seqused_q,
+            ctx.seqused_k,
+            ctx.softmax_scale,
+            ctx.deterministic,
+            ctx.sm_margin,
+        )
+        return dq, dk, dv, dbias_storage, None, None, None, None, None, None, None
+
+
+def flash_attn_compact_pair_bias_func(
+    q,
+    k,
+    v,
+    bias_storage,
+    bias_batch_offsets,
+    bias_seq_lens,
+    seqused_q,
+    seqused_k,
+    softmax_scale=None,
+    deterministic=False,
+    sm_margin=0,
+):
+    return FlashAttnCompactPairBiasFunc.apply(
+        q,
+        k,
+        v,
+        bias_storage,
+        bias_batch_offsets,
+        bias_seq_lens,
+        seqused_q,
+        seqused_k,
+        softmax_scale,
+        deterministic,
+        sm_margin,
+    )
+
+
 
